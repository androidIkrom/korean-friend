    {
      "id": "a",
      "jamo": "ㅏ",
      "kind": "vowel",
      "roman": "a",
      "say": "아",
      "name_ko": "아",
      "tip_uz": "O'zbekcha \"a\" kabi, og'izni keng oching. Bo'g'in boshida tovushsiz ㅇ bilan yoziladi: 아.",
      "tip_en": "Like \"a\" in \"father\". At the start of a syllable it is written with a silent ㅇ: 아.",
      "example": {
        "ko": "아이",
        "roman": "ai",
        "uz": "bola",
        "en": "child",
        "audio": "80812b9a2df0.mp3"
      },
      "audio": "a02641043b56.mp3"
    },
