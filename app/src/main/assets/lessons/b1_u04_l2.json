  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아, 커피! 아지즈 씨, 휴지가 있어요?",
        "uz": "Voy, qahva! Aziz, salfetka bormi?",
        "en": "Oh, the coffee! Aziz, do you have any tissues?",
        "audio": "c127f6144b2a.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "잠깐만요. 휴지가 없어요. 물티슈는 있어요.",
        "uz": "Bir daqiqa. Salfetka yo'q. Nam salfetka bor.",
        "en": "Just a moment. I don't have tissues. I have wet wipes.",
        "audio": "1e0c3afcc6a2.mp3"
      },
      {
        "speaker": "minji",
        "ko": "괜찮아요. 물티슈 주세요.",
        "uz": "Mayli. Nam salfetka bering.",
        "en": "That's fine. Give me a wet wipe.",
        "audio": "83f8a68de8c8.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "여기 있어요.",
        "uz": "Mana.",
        "en": "Here you are.",
        "audio": "86d67ad52287.mp3"
      },
      {
        "speaker": "minji",
        "ko": "고마워요. 이 컵은 아지즈 씨 거예요?",
        "uz": "Rahmat. Bu stakan sizniki, Aziz?",
        "en": "Thanks. Is this cup yours, Aziz?",
        "audio": "adab99394fa1.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아니요, 그 컵은 팅팅 씨 거예요.",
        "uz": "Yo'q, u stakan Tingtingniki.",
        "en": "No, that cup is Tingting's.",
        "audio": "60fcfb5809ed.mp3"
      },
      {
        "speaker": "minji",
        "ko": "그럼 저 가방은요?",
        "uz": "Unda anavi sumka-chi?",
        "en": "Then what about that bag over there?",
        "audio": "96bcdfd8fe9e.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저 가방은 제 거예요.",
        "uz": "Anavi sumka meniki.",
        "en": "That bag over there is mine.",
        "audio": "8fc32693700e.mp3"
      },
      {
        "speaker": "minji",
        "ko": "가방에 우산이 있어요? 밖에 비가 와요.",
        "uz": "Sumkangizda soyabon bormi? Tashqarida yomg'ir yog'yapti.",
        "en": "Is there an umbrella in your bag? It's raining outside.",
        "audio": "2a69185acd17.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아니요, 우산이 없어요.",
        "uz": "Yo'q, soyabon yo'q.",
        "en": "No, I don't have an umbrella.",
        "audio": "fd3900a50269.mp3"
      },
      {
        "speaker": "minji",
        "ko": "저는 우산이 있어요. 같이 가요!",
        "uz": "Menda soyabon bor. Birga ketamiz!",
        "en": "I have an umbrella. Let's go together!",
        "audio": "01805e056b89.mp3"
      }
    ]
  },
