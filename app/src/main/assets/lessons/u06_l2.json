        ],
        "answer": "횡단보도를 건너서 쭉 가요?",
        "uz": "Piyodalar o'tish joyidan o'tib, to'g'ri boramanmi?",
        "en": "So I cross at the crosswalk and go straight?",
        "why_uz": "건너 + 어서 → 건너서; -아서/어서 oldidan o'tgan zamon qo'yilmaydi.",
        "why_en": "건너 + 어서 → 건너서; no past tense before -아서/어서.",
        "audio": "c0aef17eeabd.mp3"
      },
      {
        "type": "line",
        "speaker": "passerby",
        "ko": "맞아요. 편의점 옆에 약국이 있어요.",
        "uz": "To'g'ri. Minimarket yonida dorixona bor.",
        "en": "That's right. There's a pharmacy next to the convenience store.",
        "audio": "367f2b5242f9.mp3"
      },
      {
        "type": "line",
        "speaker": "aziz",
        "ko": "여기에서 약국까지 멀어요?",
        "uz": "Bu yerdan dorixonagacha uzoqmi?",
        "en": "Is it far from here to the pharmacy?",
        "audio": "bde64f112a60.mp3"
      },
      {
        "type": "line",
        "speaker": "passerby",
        "ko": "아니요, 걸어서 오 분 정도 걸려요.",
        "uz": "Yo'q, piyoda besh daqiqacha.",
        "en": "No, about five minutes on foot.",
        "audio": "a235c3898c5d.mp3"
      },
      {
        "type": "quiz",
        "prompt_uz": "Dorixona nimaning yonida?",
        "prompt_en": "What is the pharmacy next to?",
        "options": [
          "Minimarket",
          "Bank",
          "Maktab"
        ],
        "options_en": [
          "A convenience store",
          "A bank",
          "A school"
        ],
        "answer": "Minimarket",
        "why_uz": "편의점 = minimarket.",
        "why_en": "편의점 = convenience store."
      },
      {
        "type": "line",
        "speaker": "aziz",
        "ko": "약국은 몇 시부터 몇 시까지 해요?",
        "uz": "Dorixona soat nechadan nechagacha ishlaydi?",
        "en": "What time is the pharmacy open from and until?",
        "audio": "4737bd54b6f2.mp3"
      },
      {
        "type": "line",
        "speaker": "passerby",
        "ko": "아침 아홉 시부터 밤 열 시까지 해요.",
        "uz": "Ertalab to'qqizdan kechki o'ngacha.",
        "en": "From nine in the morning to ten at night.",
        "audio": "3b3e06bf92dd.mp3"
      },
      {
        "type": "line",
        "speaker": "aziz",
        "ko": "감사합니다. 정말 친절하세요.",
        "uz": "Rahmat. Juda xushmuomalasiz.",
        "en": "Thank you. You're very kind.",
        "audio": "8f54b217926d.mp3"
      },
      {
        "type": "line",
        "speaker": "passerby",
        "ko": "천만에요. 조심히 가세요!",
        "uz": "Arzimaydi. Ehtiyot bo'lib boring!",
        "en": "You're welcome. Take care!",
        "audio": "ee3eb073758a.mp3"
      }
