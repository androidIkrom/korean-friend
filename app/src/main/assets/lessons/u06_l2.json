          "audio": "f58d2593de62.mp3"
        }
      ],
      "mistakes": [
        {
          "wrong": "집부터 회사까지 멀어요",
          "right": "집에서 회사까지 멀어요",
          "why_uz": "Joy uchun 에서 ... 까지."
