  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨, 오늘 날씨가 정말 추워요.",
        "uz": "Aziz, bugun havo juda sovuq.",
        "en": "Aziz, it's really cold today.",
        "audio": "129163b6562c.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 일기예보에서 영하 오 도예요.",
        "uz": "Ha, ob-havo ma'lumotida minus besh gradus.",
        "en": "Yes, the forecast says minus five.",
        "audio": "37cbca04e02c.mp3"
      },
      {
        "speaker": "minji",
        "ko": "우즈베키스탄 겨울도 추워요?",
        "uz": "O'zbekistonda qish ham sovuqmi?",
        "en": "Are winters cold in Uzbekistan too?",
        "audio": "67ce163dd3d7.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 추워요. 그런데 여름은 아주 더워요.",
        "uz": "Ha, sovuq. Lekin yoz juda issiq.",
        "en": "Yes, they're cold. But summers are very hot.",
        "audio": "66bc4b6100db.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아지즈 씨는 무슨 계절을 좋아해요?",
        "uz": "Aziz, qaysi faslni yaxshi ko'rasiz?",
        "en": "Aziz, which season do you like?",
        "audio": "24eee4331925.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저는 가을을 좋아해요. 시원하고 하늘이 맑아요.",
        "uz": "Men kuzni yaxshi ko'raman. Salqin va osmon ochiq.",
        "en": "I like autumn. It's cool and the sky is clear.",
        "audio": "92c723aa94b1.mp3"
      },
      {
        "speaker": "minji",
        "ko": "저도요! 내일은 따뜻해요. 같이 산책할까요?",
        "uz": "Men ham! Ertaga iliq bo'ladi. Birga sayr qilamizmi?",
        "en": "Me too! It'll be warm tomorrow. Shall we take a walk together?",
        "audio": "eb213478ad8d.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "좋아요. 어디에 갈까요?",
        "uz": "Mayli. Qayerga boramiz?",
        "en": "Sounds good. Where shall we go?",
        "audio": "645b98b85aad.mp3"
      },
      {
        "speaker": "minji",
        "ko": "남산에 갈까요? 학교에서 가까워요.",
        "uz": "Namsanga boramizmi? Maktabdan yaqin.",
        "en": "Shall we go to Namsan? It's close to school.",
        "audio": "0c86fa5a8acc.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 좋아요. 그런데 오늘은 너무 추워요. 카페에 갈까요?",
        "uz": "Ha, yaxshi. Lekin bugun juda sovuq. Kafega boramizmi?",
        "en": "Yes, great. But it's too cold today. Shall we go to a café?",
        "audio": "c3e9be1eff77.mp3"
      },
      {
        "speaker": "minji",
        "ko": "네, 따뜻한 차를 마셔요!",
        "uz": "Ha, issiq choy ichamiz!",
        "en": "Yes, let's drink some hot tea!",
        "audio": "80dd32027cfd.mp3"
      }
    ]
  },
