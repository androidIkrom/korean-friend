        }
      ],
      "mistakes": [
        {
          "wrong": "월요일까지 금요일부터예요.",
          "right": "월요일부터 금요일까지예요.",
          "why_uz": "Avval 부터 (boshlanish), keyin 까지.",
          "why_en": "부터 (start) comes before 까지."
        },
        {
          "wrong": "육월이에요.",
          "right": "유월이에요.",
          "why_uz": "6-oy — 유월.",
          "why_en": "June is 유월."
        },
        {
          "wrong": "십월 구 일이에요.",
          "right": "시월 구 일이에요.",
          "why_uz": "10-oy — 시월.",
          "why_en": "October is 시월."
        }
      ],
      "uz_compare": "O'zbekchadagi '-dan ... -gacha' bilan aynan bir xil: 'dushanbaDAN jumaGACHA' = 월요일부터 금요일까지.",
      "compare_en": "Exactly like English 'from … to …': 'from Monday TO Friday' = 월요일부터 금요일까지 — only the markers come after the words."
    },
    {
