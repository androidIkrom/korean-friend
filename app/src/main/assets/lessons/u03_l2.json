  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨, 막국수를 먹어 봤어요?",
        "uz": "Aziz, makguksu yeb ko'rganmisiz?",
        "en": "Aziz, have you ever eaten makguksu?",
        "audio": "95ec724b78d7.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아니요, 안 먹어 봤어요. 막국수가 뭐예요?",
        "uz": "Yo'q, yeb ko'rmaganman. Makguksu nima?",
        "en": "No, I haven't. What is makguksu?",
        "audio": "7a8b661e947c.mp3"
      },
      {
        "speaker": "minji",
        "ko": "메밀로 만든 국수예요. 강원도에서 많이 먹는 음식이에요.",
        "uz": "Grechkadan tayyorlangan ugra. Gangvondoda ko'p yeyiladigan taom.",
        "en": "Noodles made from buckwheat. It's a dish people eat a lot in Gangwon-do.",
        "audio": "b718525a818b.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "맛있어요? 저는 매운 음식을 잘 못 먹어요.",
        "uz": "Mazalimi? Men achchiq taomni yaxshi yeya olmayman.",
        "en": "Is it tasty? I can't really eat spicy food.",
        "audio": "35610ce47116.mp3"
      },
      {
        "speaker": "minji",
        "ko": "괜찮아요. 막국수는 별로 맵지 않아요.",
        "uz": "Xavotir olmang. Makguksu unchalik achchiq emas.",
        "en": "Don't worry. Makguksu isn't very spicy.",
        "audio": "eeff27e1192e.mp3"
      },
      {
        "speaker": "seller",
        "ko": "어서 오세요. 뭐 주문하시겠어요?",
        "uz": "Xush kelibsiz. Nima buyurtma berasiz?",
        "en": "Welcome. What would you like to order?",
        "audio": "0611fd7f6350.mp3"
      },
      {
        "speaker": "minji",
        "ko": "막국수 두 그릇 주세요.",
        "uz": "Ikki kosa makguksu bering.",
        "en": "Two bowls of makguksu, please.",
        "audio": "b240c9c9dd04.mp3"
      },
      {
        "speaker": "seller",
        "ko": "네, 잠깐만 기다리세요.",
        "uz": "Xo'p, biroz kuting.",
        "en": "Sure, just a moment.",
        "audio": "2779dd91fc0e.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "와, 정말 맛있어요! 강원도에 오는 관광객들이 다 이걸 먹어요?",
        "uz": "Voy, juda mazali! Gangvondoga keladigan sayyohlar hammasi buni yeydimi?",
        "en": "Wow, it's really delicious! Do all the tourists who come to Gangwon-do eat this?",
        "audio": "9a10e374cb68.mp3"
      },
      {
        "speaker": "minji",
        "ko": "네, 특히 여름에 많이 먹는 음식이에요.",
        "uz": "Ha, ayniqsa yozda ko'p yeyiladigan taom.",
        "en": "Yes, it's a dish people eat a lot, especially in summer.",
        "audio": "5b2cbe0ed373.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "친구들한테도 추천할 거예요.",
        "uz": "Do'stlarimga ham tavsiya qilaman.",
        "en": "I'll recommend it to my friends too.",
        "audio": "cd1d1ec76c89.mp3"
      }
    ]
  },
