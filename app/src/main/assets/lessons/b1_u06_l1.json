      ],
      "mistakes": [
        {
          "wrong": "사과을 먹어요.",
          "right": "사과를 먹어요.",
          "why_uz": "사과 unli bilan tugaydi: 를.",
          "why_en": "사과 ends in a vowel: 를."
        },
        {
          "wrong": "책를 읽어요.",
          "right": "책을 읽어요.",
          "why_uz": "책 받침 bilan tugaydi: 을.",
          "why_en": "책 ends in 받침: 을."
        },
        {
          "wrong": "저는 먹어요 빵을.",
          "right": "저는 빵을 먹어요.",
          "why_uz": "Fe'l doim gap oxirida.",
          "why_en": "The verb always comes last."
        }
      ],
      "uz_compare": "O'zbekchadagi '-ni' kelishigiga juda o'xshaydi va so'z tartibi ham bir xil: 'Men olmaNI yeyman' = 저는 사과를 먹어요. Fe'l ikkala tilda ham oxirida.",
      "compare_en": "English shows the object by position (after the verb). Korean marks it with 을/를 and puts the verb last: 'I eat an apple' = 저는 사과를 먹어요 ('I apple eat')."
    }
