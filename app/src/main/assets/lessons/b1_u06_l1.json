          "audio": "6c7368677970.mp3"
        },
        {
          "ko": "숙제를 해요.",
          "uz": "Uy vazifasini qilyapman.",
          "en": "I'm doing homework.",
          "audio": "6206e97e6873.mp3"
        },
        {
          "ko": "친구에게 편지를 써요.",
          "uz": "Do'stimga xat yozyapman.",
          "en": "I'm writing a letter to a friend.",
          "audio": "9372449719e8.mp3"
        },
        {
          "ko": "음악을 좋아해요.",
          "uz": "Musiqani yaxshi ko'raman.",
