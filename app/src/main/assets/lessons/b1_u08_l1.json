  "dialogue": {
    "lines": [
      {
        "speaker": "aziz",
        "ko": "민지 씨, 지금 몇 시예요?",
        "uz": "Minji, hozir soat necha?",
        "en": "Minji, what time is it now?",
        "audio": "84831082f628.mp3"
      },
      {
        "speaker": "minji",
        "ko": "여덟 시 반이에요. 왜요?",
        "uz": "Sakkiz yarim. Nega?",
        "en": "Half past eight. Why?",
        "audio": "710ae0ed2293.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아홉 시에 수업이 있어요. 늦어요!",
        "uz": "Soat to'qqizda darsim bor. Kech qolyapman!",
        "en": "I have class at nine. I'm going to be late!",
        "audio": "3145f8607468.mp3"
      },
      {
        "speaker": "minji",
        "ko": "괜찮아요. 아직 삼십 분 있어요.",
        "uz": "Hechqisi yo'q. Hali o'ttiz daqiqa bor.",
        "en": "It's okay. You still have thirty minutes.",
        "audio": "c687e66fe3f6.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "수업은 보통 몇 시에 끝나요?",
        "uz": "Dars odatda soat nechada tugaydi?",
        "en": "What time does class usually finish?",
        "audio": "89a22e6341a4.mp3"
      },
      {
        "speaker": "minji",
        "ko": "한 시에 끝나요. 아지즈 씨는 수업이 끝나고 뭐 해요?",
        "uz": "Soat birda. Aziz, dars tugagach nima qilasiz?",
        "en": "At one. Aziz, what do you do after class?",
        "audio": "0819bdc3b557.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "점심을 먹고 도서관에 가요.",
        "uz": "Tushlik qilib, kutubxonaga boraman.",
        "en": "I have lunch and then go to the library.",
        "audio": "054aa7cca139.mp3"
      },
      {
        "speaker": "minji",
        "ko": "금요일에도 도서관에 가요?",
        "uz": "Juma kuni ham kutubxonaga borasizmi?",
        "en": "Do you go to the library on Friday too?",
        "audio": "8bbe712873f6.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아니요, 금요일 오후에는 아르바이트를 해요.",
        "uz": "Yo'q, juma kuni tushdan keyin ishlayman.",
        "en": "No, on Friday afternoons I have a part-time job.",
        "audio": "c5067da3cd56.mp3"
      },
      {
        "speaker": "minji",
        "ko": "그럼 토요일에 같이 영화 봐요!",
        "uz": "Unda shanba kuni birga kino ko'raylik!",
        "en": "Then let's watch a film together on Saturday!",
        "audio": "8aaa8eb45a49.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "좋아요! 이제 빨리 가요!",
        "uz": "Zo'r! Endi tez ketaman!",
        "en": "Great! I really need to go now!",
        "audio": "a825ba677f85.mp3"
      }
    ]
  },
