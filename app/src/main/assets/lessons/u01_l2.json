  "dialogue": {
    "lines": [
      {
        "speaker": "aziz",
        "ko": "민지 씨 어머니는 지금 무슨 일을 하세요?",
        "uz": "Minji, onangiz hozir qanday ish qiladilar?",
        "en": "Minji, what does your mother do now?",
        "audio": "9619c52094dd.mp3"
      },
      {
        "speaker": "minji",
        "ko": "지금은 일을 안 하세요. 주부세요.",
        "uz": "Hozir ishlamaydilar. Uy bekasilar.",
        "en": "She doesn't work now. She's a homemaker.",
        "audio": "fd5da3646c6a.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "어머니는 전에 무슨 일을 하셨어요?",
        "uz": "Onangiz avval qanday ishda ishlaganlar?",
        "en": "What did your mother do before?",
        "audio": "cd9f3a2b2d44.mp3"
      },
      {
        "speaker": "minji",
        "ko": "전에는 은행원이셨어요. 결혼하고 일을 그만두셨어요.",
        "uz": "Avval bank xodimi edilar. Turmush qurib, ishni tashladilar.",
        "en": "She used to be a bank clerk. She got married and quit her job.",
        "audio": "1f637a0b35b8.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아, 그래요? 아버지는요?",
        "uz": "Shundaymi? Otangiz-chi?",
        "en": "Oh, really? What about your father?",
        "audio": "99edf96b714a.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아버지는 고등학교 선생님이셨어요. 작년에 은퇴하셨어요.",
        "uz": "Otam maktab o'qituvchisi edilar. O'tgan yili nafaqaga chiqdilar.",
        "en": "My father was a high school teacher. He retired last year.",
        "audio": "0425bbc3196c.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아버지는 어떤 분이세요?",
        "uz": "Otangiz qanday odam?",
        "en": "What kind of person is your father?",
        "audio": "8ad129c3a188.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아버지는 조용하고 친절하세요. 어머니는 재미있고 부지런하세요.",
        "uz": "Otam jim va mehribonlar. Onam esa quvnoq va mehnatkashlar.",
        "en": "My father is quiet and kind. My mother is cheerful and hard-working.",
        "audio": "f5892f99dc83.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "부모님은 어디에서 태어나셨어요?",
        "uz": "Ota-onangiz qayerda tug'ilganlar?",
        "en": "Where were your parents born?",
        "audio": "630b836c9a49.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아버지는 부산에서 태어나셨고 어머니는 서울에서 태어나셨어요.",
        "uz": "Otam Pusanda, onam esa Seulda tug'ilganlar.",
        "en": "My father was born in Busan, and my mother was born in Seoul.",
        "audio": "22b6a6f315b0.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "우리 아버지는 운전기사세요. 그리고 어머니는 전에 요리사셨어요.",
        "uz": "Mening otam haydovchilar. Onam esa avval oshpaz edilar.",
        "en": "My father is a driver. And my mother used to be a cook.",
        "audio": "59611d0f833a.mp3"
      },
      {
        "speaker": "minji",
        "ko": "와, 어머니께서 요리를 잘하세요?",
        "uz": "Voy, onangiz yaxshi ovqat pishiradilarmi?",
        "en": "Wow, is your mother a good cook?",
        "audio": "7f83ab3991f2.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 정말 잘하세요.",
        "uz": "Ha, juda yaxshi pishiradilar.",
        "en": "Yes, she's a really good cook.",
        "audio": "49d9966a1ce6.mp3"
