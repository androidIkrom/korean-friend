  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨, 대학교를 졸업한 후에 뭐 하고 싶어요?",
        "uz": "Aziz, universitetni bitirgach nima qilmoqchisiz?",
        "en": "Aziz, what do you want to do after graduating?",
        "audio": "6b3629eb679a.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아직 고민돼요. 취업할지 대학원에 진학할지 모르겠어요.",
        "uz": "Hali ikkilanyapman. Ishga kirsammi, magistraturagami — bilmayman.",
        "en": "I'm still torn. I don't know whether to get a job or go to grad school.",
        "audio": "2097cd3d48ab.mp3"
      },
      {
        "speaker": "minji",
        "ko": "꿈이 뭐예요?",
        "uz": "Orzuingiz nima?",
        "en": "What's your dream?",
        "audio": "162bcfc85a54.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "제 꿈은 통역사예요. 한국어하고 우즈베크어 통역사가 되고 싶어요.",
        "uz": "Orzuim — tarjimon. Koreys va o'zbek tillari tarjimoni bo'lmoqchiman.",
        "en": "My dream is to be an interpreter — between Korean and Uzbek.",
        "audio": "ef99193ce9e8.mp3"
      },
      {
        "speaker": "minji",
        "ko": "멋있네요! 그럼 졸업하기 전에 뭘 준비해야 돼요?",
        "uz": "Zo'r! Unda bitirishdan oldin nimaga tayyorlanish kerak?",
        "en": "That's cool! So what do you need to prepare before graduating?",
        "audio": "4c44ddcedb67.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "졸업하기 전에 통역 자격증을 따고, 인턴십도 할 거예요.",
        "uz": "Bitirishdan oldin tarjimonlik sertifikatini olaman, amaliyot ham o'tayman.",
        "en": "Before I graduate, I'll get an interpreting certificate and do an internship.",
        "audio": "c8382dc3f0dd.mp3"
      },
      {
        "speaker": "minji",
        "ko": "졸업한 후에는 귀국할 거예요?",
        "uz": "Bitirgach vataningizga qaytasizmi?",
        "en": "Will you go back home after graduating?",
        "audio": "1cf3f3b247b9.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "한국에서 경험을 쌓은 후에 귀국하고 싶어요.",
        "uz": "Koreyada tajriba to'plagach, qaytmoqchiman.",
        "en": "I want to go back after gaining experience in Korea.",
        "audio": "021d2df50a5e.mp3"
      },
      {
        "speaker": "minji",
        "ko": "부모님도 보고 싶지요?",
        "uz": "Ota-onangizni ham sog'ingandirsiz?",
        "en": "You must miss your parents too.",
        "audio": "7efe1ace8a64.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 귀국한 후에 부모님께 효도하고 싶어요.",
        "uz": "Ha, qaytgach, ota-onamga yaxshilik qilmoqchiman.",
        "en": "Yes. After I go back, I want to take care of my parents.",
        "audio": "a57bc18dee11.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아지즈 씨는 꼭 꿈을 이룰 거예요!",
        "uz": "Aziz, siz albatta orzuingizga erishasiz!",
        "en": "Aziz, you'll definitely achieve your dream!",
        "audio": "bb930bfd2d30.mp3"
      }
    ]
  },
