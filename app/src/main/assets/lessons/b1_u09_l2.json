  "dialogue": {
    "lines": [
      {
        "speaker": "aziz",
        "ko": "실례합니다. 서점이 어디에 있어요?",
        "uz": "Kechirasiz, kitob do'koni qayerda?",
        "en": "Excuse me, where's the bookshop?",
        "audio": "17ea9a6baaad.mp3"
      },
      {
        "speaker": "passerby",
        "ko": "서점이요? 저 건물 이 층에 있어요.",
        "uz": "Kitob do'konimi? Anavi binoning ikkinchi qavatida.",
        "en": "The bookshop? It's on the second floor of that building.",
        "audio": "17106ea33ad1.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저 건물이요? 은행 옆에 있어요?",
        "uz": "Anavi binomi? Bank yonidami?",
        "en": "That building? Is it next to the bank?",
        "audio": "3cbf1d6e2de6.mp3"
      },
      {
        "speaker": "passerby",
        "ko": "네, 은행하고 약국 사이에 있어요.",
        "uz": "Ha, bank bilan dorixona orasida.",
        "en": "Yes, it's between the bank and the pharmacy.",
        "audio": "8bac0daae3a5.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "엘리베이터가 있어요?",
        "uz": "Lift bormi?",
        "en": "Is there an elevator?",
        "audio": "6b487f3ec8f1.mp3"
      },
      {
        "speaker": "passerby",
        "ko": "아니요, 엘리베이터는 없어요. 계단으로 올라가세요.",
        "uz": "Yo'q, lift yo'q. Zinadan chiqing.",
        "en": "No, there's no elevator. Take the stairs up.",
        "audio": "30da21c800e5.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "고맙습니다. 그리고 지하철역은 어디에 있어요?",
        "uz": "Rahmat. Metro bekati-chi, qayerda?",
        "en": "Thank you. And where's the subway station?",
        "audio": "38a38185d580.mp3"
      },
      {
        "speaker": "passerby",
        "ko": "이쪽으로 쭉 가세요. 그리고 오른쪽으로 가세요.",
        "uz": "Bu tomonga to'g'ri boring. Keyin o'ngga buriling.",
        "en": "Go straight this way. Then turn right.",
        "audio": "8d048ef21189.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "오른쪽으로요?",
        "uz": "O'nggami?",
        "en": "To the right?",
        "audio": "cd5fdf4f99f3.mp3"
      },
      {
        "speaker": "passerby",
        "ko": "네, 편의점 앞에 지하철역 입구가 있어요.",
        "uz": "Ha, do'kon oldida metroning kirishi bor.",
        "en": "Yes, the subway entrance is in front of the convenience store.",
        "audio": "ad3722a855cc.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "정말 감사합니다!",
        "uz": "Katta rahmat!",
        "en": "Thank you so much!",
        "audio": "1ace399a2b72.mp3"
      }
    ]
  },
