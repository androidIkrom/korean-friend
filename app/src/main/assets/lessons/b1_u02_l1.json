  "dialogue": {
    "lines": [
      {
        "speaker": "teacher",
        "ko": "여러분, 오늘은 발음을 공부해요.",
        "uz": "Bolalar, bugun talaffuzni o'rganamiz.",
        "en": "Everyone, today we're studying pronunciation.",
        "audio": "f424071cfff7.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "아지즈 씨, 이 단어를 읽으세요.",
        "uz": "Aziz, bu so'zni o'qing.",
        "en": "Aziz, please read this word.",
        "audio": "2c076a127210.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "음… 음악?",
        "uz": "Hmm… eum-ak?",
        "en": "Hmm… eum-ak?",
        "audio": "66832c1bc611.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "아니요, [으막]이에요. 다시 따라 하세요.",
        "uz": "Yo'q, [eumak]. Yana takrorlang.",
        "en": "No, it's [eumak]. Repeat after me.",
        "audio": "5b031c5004c4.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "으막.",
        "uz": "Eumak.",
        "en": "Eumak.",
        "audio": "0554191c513d.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "네, 맞아요! 그럼 이 단어는요? 한국어.",
        "uz": "Ha, to'g'ri! Bu so'z-chi? 한국어.",
        "en": "Yes, that's right! And this word? 한국어.",
        "audio": "c492e1946af0.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "한구거!",
        "uz": "Hanguko!",
        "en": "Hanguko!",
        "audio": "b0e9b08514a2.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "아주 좋아요. 받침이 다음 글자로 가요.",
        "uz": "Juda yaxshi. 받침 keyingi harfga o'tadi.",
        "en": "Very good. The final consonant moves to the next syllable.",
        "audio": "665181994269.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "선생님, 꽃하고 꼳은 소리가 같아요?",
        "uz": "Ustoz, 꽃 bilan 꼳 bir xil eshitiladimi?",
        "en": "Teacher, do 꽃 and 꼳 sound the same?",
        "audio": "dccbefb7ea87.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "네, 같아요. 그런데 '꽃이'는 [꼬치]예요.",
        "uz": "Ha, bir xil. Lekin '꽃이' — [kkochi] deb o'qiladi.",
        "en": "Yes, they do. But '꽃이' is read [kkochi].",
        "audio": "e1678577e117.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "아, 어려워요. 그래도 재미있어요!",
        "uz": "Voy, qiyin. Lekin qiziq!",
        "en": "Oh, it's hard. But it's fun!",
        "audio": "8788fef2266a.mp3"
      }
    ]
  },
