      "mistakes": [
        {
          "wrong": "도서관에 공부해요.",
          "right": "도서관에서 공부해요.",
          "why_uz": "'O'qimoq' — ish-harakat: 에서.",
          "why_en": "'Study' is an action: 에서."
        },
        {
          "wrong": "학교에서 가요.",
          "right": "학교에 가요.",
          "why_uz": "'Bormoq' bilan yo'nalish — 에.",
          "why_en": "With 'go', direction takes 에."
        },
        {
          "wrong": "집에서 있어요.",
          "right": "집에 있어요.",
          "why_uz": "'Bor/turibdi' — 있다 bilan 에.",
          "why_en": "With 있다 use 에."
        }
      ],
      "uz_compare": "O'zbekchadagi '-da' ga o'xshaydi: 'kutubxonaDA o'qiyman' = 도서관에서 공부해요. Lekin 'uyda bor' (joylashuv) uchun koreyschada 에 ishlatiladi: 집에 있어요.",
      "compare_en": "Like English 'at/in' for actions: 'study AT the library' = 도서관에서 공부해요. But for simply being somewhere, Korean uses 에: 집에 있어요."
    }
