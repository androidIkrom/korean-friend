  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨, 어디에 가요?",
        "uz": "Aziz, qayerga ketyapsiz?",
        "en": "Aziz, where are you going?",
        "audio": "0dcb7e333892.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "우체국에 가요. 고향에 소포를 보내요.",
        "uz": "Pochtaga. Vatanimga posilka jo'nataman.",
        "en": "To the post office. I'm sending a parcel home.",
        "audio": "179d750affe7.mp3"
      },
      {
        "speaker": "minji",
        "ko": "아, 그래요? 우체국은 저기예요.",
        "uz": "A, shundaymi? Pochta anavi yerda.",
        "en": "Oh, really? The post office is over there.",
        "audio": "80f13224832b.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "고마워요. 민지 씨는 어디에 가요?",
        "uz": "Rahmat. Siz-chi, Minji, qayerga ketyapsiz?",
        "en": "Thanks. Where are you going, Minji?",
        "audio": "2009d392fc7b.mp3"
      },
      {
        "speaker": "minji",
        "ko": "저는 도서관에 가요. 도서관에서 시험 공부를 해요.",
        "uz": "Men kutubxonaga. Kutubxonada imtihonga tayyorlanaman.",
        "en": "I'm going to the library. I'm studying for an exam there.",
        "audio": "a7cc060866a3.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "도서관 다음에 뭐 해요?",
        "uz": "Kutubxonadan keyin nima qilasiz?",
        "en": "What are you doing after the library?",
        "audio": "54d1f311ffaf.mp3"
      },
      {
        "speaker": "minji",
        "ko": "시장에 가요. 시장에서 과일을 사요.",
        "uz": "Bozorga boraman. Bozordan meva olaman.",
        "en": "I'm going to the market. I'm buying fruit there.",
        "audio": "74d88f37e115.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저도 시장에 가요! 같이 가요.",
        "uz": "Men ham bozorga boraman! Birga boraylik.",
        "en": "I'm going to the market too! Let's go together.",
        "audio": "8bf7df6a864d.mp3"
      },
      {
        "speaker": "minji",
        "ko": "좋아요. 그럼 다섯 시에 시장 앞에서 만나요.",
        "uz": "Yaxshi. Unda soat beshda bozor oldida uchrashamiz.",
        "en": "Good. Then let's meet in front of the market at five.",
        "audio": "5f98882bce63.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 거기에서 기다려요.",
        "uz": "Xo'p, o'sha yerda kutaman.",
        "en": "Okay, I'll wait there.",
        "audio": "e00888933450.mp3"
      },
      {
        "speaker": "minji",
        "ko": "이따 봐요!",
        "uz": "Keyin ko'rishamiz!",
        "en": "See you later!",
        "audio": "12aa66291b33.mp3"
      }
    ]
  },
