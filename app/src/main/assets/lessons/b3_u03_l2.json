        },
        {
          "wrong": "학생는데 …",
          "right": "학생인데 …",
          "why_uz": "Ot: 인데.",
          "why_en": "Noun: 인데."
        }
      ],
      "uz_compare": "O'zbekchada bunday gaplar ko'pincha vergul bilan yasaladi: 'Myuzikl ko'rdim, juda qiziq bo'ldi'. Koreyschada bu vergul vazifasini -는데 bajaradi.",
      "compare_en": "English often joins these with 'and' or 'but': 'I saw a musical AND it was fun'. Korean uses -는데 to set the scene before the main point."
    }
