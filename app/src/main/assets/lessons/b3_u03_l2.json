  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨, 주말에 뭐 했어요?",
        "uz": "Aziz, dam olish kunlari nima qildingiz?",
        "en": "Aziz, what did you do at the weekend?",
        "audio": "188011924655.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "대학로에서 뮤지컬을 봤는데 정말 재미있었어요.",
        "uz": "Teharoda myuzikl ko'rdim, juda qiziq bo'ldi.",
        "en": "I saw a musical in Daehak-ro, and it was really fun.",
        "audio": "365598f6e07e.mp3"
      },
      {
        "speaker": "minji",
        "ko": "와, 무슨 뮤지컬이었어요?",
        "uz": "Voy, qanday myuzikl edi?",
        "en": "Wow, which musical was it?",
        "audio": "b49e8eb82982.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "유명한 뮤지컬인데 표가 거의 매진이었어요.",
        "uz": "Mashhur myuzikl, chiptalar deyarli tugagan edi.",
        "en": "It's a famous one, and the tickets were almost sold out.",
        "audio": "87d8186326f3.mp3"
      },
      {
        "speaker": "minji",
        "ko": "줄거리는 어땠어요?",
        "uz": "Syujeti qanday edi?",
        "en": "How was the plot?",
        "audio": "c1d68983fdb9.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "처음에는 웃겼는데 마지막 장면은 정말 감동적이었어요.",
        "uz": "Avvaliga kulgili edi, lekin oxirgi sahna juda ta'sirli bo'ldi.",
        "en": "It was funny at first, but the last scene was really moving.",
        "audio": "05a86a18a775.mp3"
      },
      {
        "speaker": "minji",
        "ko": "울었어요?",
        "uz": "Yig'ladingizmi?",
        "en": "Did you cry?",
        "audio": "796d6ac65f1f.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "네, 조금 울었어요. 공연이 끝났을 때 모두 박수를 쳤어요.",
        "uz": "Ha, biroz yig'ladim. Tomosha tugaganda hamma qarsak chaldi.",
        "en": "Yes, a little. When the show ended, everyone clapped.",
        "audio": "5b0de4a1d912.mp3"
      },
      {
        "speaker": "minji",
        "ko": "저도 고등학생이었을 때 뮤지컬 동아리에서 노래를 불렀어요.",
        "uz": "Men ham yuqori sinfda musiqiy to'garakda qo'shiq aytganman.",
        "en": "I sang in a musical club when I was in high school, too.",
        "audio": "bcd88fb1e947.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "정말요? 민지 씨 노래를 듣고 싶어요!",
        "uz": "Rostdanmi? Minji, qo'shig'ingizni eshitgim keladi!",
        "en": "Really? I'd love to hear you sing!",
        "audio": "113ecebbc02b.mp3"
      },
      {
        "speaker": "minji",
        "ko": "하하, 다음에 노래방에 같이 가요.",
        "uz": "Haha, keyingi safar birga karaokega boramiz.",
        "en": "Haha, let's go to karaoke together next time.",
        "audio": "f1c87c466cfc.mp3"
      }
    ]
  },
