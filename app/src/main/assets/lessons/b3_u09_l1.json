        "audio": "662bb7fb6a0f.mp3"
      },
      {
        "type": "choose_reply",
        "speaker": "aziz",
        "prompt_uz": "Aziz 'Oiladek do'stlarim bor, shuning uchun yaxshi' demoqchi.",
