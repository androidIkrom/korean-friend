  "dialogue": {
    "lines": [
      {
        "speaker": "minji",
        "ko": "아지즈 씨는 취미가 뭐예요?",
        "uz": "Aziz, xobbingiz nima?",
        "en": "Aziz, what's your hobby?",
        "audio": "6f886c128775.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저는 축구를 좋아해요. 민지 씨는요?",
        "uz": "Men futbolni yaxshi ko'raman. Siz-chi, Minji?",
        "en": "I love football. What about you, Minji?",
        "audio": "c4b561ab93f8.mp3"
      },
      {
        "speaker": "minji",
        "ko": "저는 요가를 해요. 그런데 요즘 테니스를 배우고 싶어요.",
        "uz": "Men yoga qilaman. Lekin hozir tennisni o'rganmoqchiman.",
        "en": "I do yoga. But now I want to learn tennis.",
        "audio": "3f5bf3ad91f1.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "테니스요? 저는 테니스를 전혀 못 쳐요.",
        "uz": "Tennismi? Men tennisni umuman o'ynay olmayman.",
        "en": "Tennis? I can't play tennis at all.",
        "audio": "e74cd5761e03.mp3"
      },
      {
        "speaker": "minji",
        "ko": "그럼 같이 배워요! 학교 체육관에서 테니스를 가르쳐요.",
        "uz": "Unda birga o'rganamiz! Maktab sport zalida tennisdan dars berishadi.",
        "en": "Then let's learn together! They give tennis lessons in the school gym.",
        "audio": "3a197092e192.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "정말요? 언제 배워요?",
        "uz": "Rostdanmi? Qachon o'rganamiz?",
        "en": "Really? When will we learn?",
        "audio": "feade3c0850c.mp3"
      },
      {
        "speaker": "minji",
        "ko": "일주일에 두 번, 화요일하고 목요일에 수업이 있어요.",
        "uz": "Haftada ikki marta, seshanba va payshanba kunlari dars bor.",
        "en": "There are lessons twice a week, on Tuesdays and Thursdays.",
        "audio": "64d4c4e4d153.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저는 화요일에는 못 가요. 목요일에는 괜찮아요.",
        "uz": "Men seshanba kuni bora olmayman. Payshanba kuni mumkin.",
        "en": "I can't go on Tuesday. Thursday is fine.",
        "audio": "2f78f49e929b.mp3"
      },
      {
        "speaker": "minji",
        "ko": "괜찮아요. 목요일에 같이 가요.",
        "uz": "Mayli. Payshanba kuni birga boramiz.",
        "en": "OK. Let's go together on Thursday.",
        "audio": "a3aa7ddb71a3.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "좋아요. 그런데 저는 라켓이 없어요.",
        "uz": "Yaxshi. Lekin mening raketkam yo'q.",
        "en": "Good. But I don't have a racket.",
        "audio": "b2d77e5b5530.mp3"
      },
      {
        "speaker": "minji",
        "ko": "체육관에 라켓이 있어요. 걱정 마세요.",
        "uz": "Sport zalida raketka bor. Xavotir olmang.",
        "en": "There are rackets at the gym. Don't worry.",
        "audio": "3047f8c5de2c.mp3"
      }
    ]
  },
