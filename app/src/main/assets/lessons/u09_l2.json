  "dialogue": {
    "lines": [
      {
        "speaker": "aziz",
        "ko": "여보세요, 민지 씨. 지금 뭐 하고 있어요?",
        "uz": "Allo, Minji. Hozir nima qilyapsiz?",
        "en": "Hello, Minji. What are you doing now?",
        "audio": "891e88f5ba88.mp3"
      },
      {
        "speaker": "minji",
        "ko": "카페에서 차 마시면서 책 읽고 있어요.",
        "uz": "Kafeda choy ichib turib kitob o'qiyapman.",
        "en": "I'm reading a book at a café while drinking tea.",
        "audio": "030c05b10fb3.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "무슨 책을 읽고 있어요?",
        "uz": "Qanaqa kitob o'qiyapsiz?",
        "en": "What kind of book are you reading?",
        "audio": "b758d5f6606b.mp3"
      },
      {
        "speaker": "minji",
        "ko": "한국 소설이에요. 아지즈 씨는요?",
        "uz": "Koreys romani. Siz-chi, Aziz?",
        "en": "A Korean novel. What about you, Aziz?",
        "audio": "f0c7b30355a4.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저는 집에서 음악을 들으면서 청소하고 있어요.",
        "uz": "Men uyda musiqa tinglab turib uy yig'ishtiryapman.",
        "en": "I'm cleaning the house while listening to music.",
        "audio": "7583eae1ee7c.mp3"
      },
      {
        "speaker": "minji",
        "ko": "우와, 대단해요. 그런데 왜 전화했어요?",
        "uz": "Voy, zo'r. Aytgancha, nega qo'ng'iroq qildingiz?",
        "en": "Wow, nice. By the way, why did you call?",
        "audio": "b9031b696561.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "이따가 우리 집에서 같이 드라마 보면서 저녁 먹어요.",
        "uz": "Birozdan keyin bizning uyda birga serial ko'rib turib kechki ovqat qilaylik.",
        "en": "Let's have dinner at my place in a little while and watch a drama together.",
        "audio": "73d9451aad8a.mp3"
      },
      {
        "speaker": "minji",
        "ko": "좋아요! 몇 시에 갈까요?",
        "uz": "Zo'r! Soat nechada boray?",
        "en": "Great! What time should I come?",
        "audio": "1ed0621c8ea4.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "일곱 시쯤 오세요. 제가 치킨을 시킬게요.",
        "uz": "Soat yettilarda keling. Men tovuq buyurtma qilaman.",
        "en": "Come at around seven. I'll order some chicken.",
        "audio": "de8d95a7d362.mp3"
      },
      {
        "speaker": "minji",
        "ko": "그럼 제가 음료수를 사 갈게요.",
        "uz": "Unda men ichimlik olib boraman.",
        "en": "Then I'll bring drinks.",
        "audio": "458d68d0c4c7.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "고마워요. 지금 동생이 기다리고 있어서 전화를 끊을게요.",
        "uz": "Rahmat. Hozir ukam kutib turgani uchun telefonni qo'yaman.",
        "en": "Thanks. My younger brother is waiting, so I'll hang up now.",
        "audio": "a9ea8be6ade8.mp3"
      },
      {
        "speaker": "minji",
        "ko": "네, 이따가 봐요!",
        "uz": "Xo'p, keyin ko'rishamiz!",
        "en": "OK, see you later!",
        "audio": "8636696909b1.mp3"
      }
    ]
  },
