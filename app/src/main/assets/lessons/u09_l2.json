        },
        {
          "condition_uz": "받침 bor",
          "condition_en": "With 받침",
          "rule": "-으면서",
          "example": "먹다 → 먹으면서"
        },
        {
          "condition_uz": "ㄹ bilan tugasa",
          "condition_en": "Ends in ㄹ",
          "rule": "-면서",
          "example": "만들다 → 만들면서"
        },
        {
          "condition_uz": "ㄷ 불규칙",
          "condition_en": "ㄷ-irregular",
          "rule": "ㄷ → ㄹ + -으면서",
          "example": "듣다 → 들으면서"
        }
      ],
