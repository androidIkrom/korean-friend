  "dialogue": {
    "lines": [
      {
        "speaker": "junho",
        "ko": "아지즈 씨, 몇 학번이에요?",
        "uz": "Aziz, qaysi yili o'qishga kirgansiz?",
        "en": "Aziz, what year did you enter?",
        "audio": "44462b64198a.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "저는 26학번이에요. 준호 씨는요?",
        "uz": "Men 26-yil. Siz-chi, Junho?",
        "en": "I entered in '26. And you, Junho?",
        "audio": "a94b4d19302a.mp3"
      },
      {
        "speaker": "junho",
        "ko": "저도 26학번이에요. 나이는요?",
        "uz": "Men ham 26. Yoshingiz-chi?",
        "en": "Me too, '26. How old are you?",
        "audio": "e85b6de1d9d1.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "스무 살이에요.",
        "uz": "Yigirma yoshdaman.",
        "en": "I'm twenty.",
        "audio": "892d67e0dd99.mp3"
      },
      {
        "speaker": "junho",
        "ko": "와, 우리 동갑이네요! 우리 같은 신입생이니까 말 놓을까요?",
        "uz": "Voy, tengdosh ekanmiz! Ikkalamiz ham birinchi kurs, \"sen\"lashaylikmi?",
        "en": "Wow, we're the same age! We're both freshmen, so shall we speak casually?",
        "audio": "f3b28a479008.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "좋아요. 아니, 좋아! 아직 좀 어색해.",
        "uz": "Yaxshi. Yo'q, yaxshi! Hali biroz noqulay.",
        "en": "Sure. I mean — sure! It still feels a bit awkward.",
        "audio": "521483e08ebe.mp3"
      },
      {
        "speaker": "junho",
        "ko": "하하, 금방 편해질 거야. 그냥 준호라고 불러.",
        "uz": "Haha, tez o'rganasan. Shunchaki Junho de.",
        "en": "Haha, you'll get used to it. Just call me Junho.",
        "audio": "3951f5b6a8fc.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "응, 알았어. 준호야, 밥 먹었어?",
        "uz": "Ha, xo'p. Junho, ovqatlandingmi?",
        "en": "Okay, got it. Junho, have you eaten?",
        "audio": "4dbd3226aa90.mp3"
      },
      {
        "speaker": "junho",
        "ko": "아니, 아직. 같이 먹자! 학생 식당 갈래?",
        "uz": "Yo'q, hali. Birga yeymiz! Talabalar oshxonasiga boramizmi?",
        "en": "No, not yet. Let's eat together! Want to go to the student cafeteria?",
        "audio": "8dca64c9600e.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "그래, 가자! 나 오늘 비빔밥 먹을 거야.",
        "uz": "Mayli, ketdik! Men bugun pibimbap yeyman.",
        "en": "Sure, let's go! I'm having bibimbap today.",
        "audio": "ec0ba8642414.mp3"
      },
      {
        "speaker": "junho",
        "ko": "좋아. 아, 번호 좀 알려 줘. 자주 연락하자!",
        "uz": "Yaxshi. A, raqamingni ayt. Tez-tez gaplashib turaylik!",
        "en": "Great. Oh, give me your number. Let's keep in touch!",
        "audio": "bcce5b809c4b.mp3"
      }
    ]
  },
