      "mistakes": [
        {
          "wrong": "선생님는 한국 사람이에요.",
          "right": "선생님은 한국 사람이에요.",
          "why_uz": "선생님 받침 bilan tugaydi: 선생님은.",
          "why_en": "선생님 ends in 받침: 선생님은."
        },
        {
          "wrong": "저은 학생이에요.",
