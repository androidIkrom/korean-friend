  "dialogue": {
    "lines": [
      {
        "speaker": "teacher",
        "ko": "여러분, 십 분 후에 시험을 시작해요.",
        "uz": "Hammaga, o'n daqiqadan keyin imtihonni boshlaymiz.",
        "en": "Everyone, we'll start the exam in ten minutes.",
        "audio": "54edd0a7987f.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "선생님, 시험을 볼 때 연필로 써도 돼요?",
        "uz": "Ustoz, imtihonda qalam bilan yozsam bo'ladimi?",
        "en": "Teacher, may I write with a pencil in the exam?",
        "audio": "6eab99fd7783.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "아니요, 연필로 쓰면 안 돼요. 볼펜으로 쓰세요.",
        "uz": "Yo'q, qalam bilan yozish mumkin emas. Ruchka bilan yozing.",
        "en": "No, you can't write with a pencil. Write with a pen.",
        "audio": "dfe335a19bf8.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "볼펜이 없는데요. 친구 볼펜을 빌려도 돼요?",
        "uz": "Ruchkam yo'q edi. Do'stimning ruchkasini olsam bo'ladimi?",
        "en": "I didn't bring a pen. May I borrow my friend's pen?",
        "audio": "40467589c218.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "네, 빌려도 돼요.",
        "uz": "Ha, olsangiz bo'ladi.",
        "en": "Yes, you may.",
        "audio": "e295b1cf141e.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "사전을 봐도 돼요?",
        "uz": "Lug'at ko'rsam bo'ladimi?",
        "en": "May I use a dictionary?",
        "audio": "567248a14004.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "아니요, 사전을 보면 안 돼요. 그리고 휴대폰은 꺼 주세요.",
        "uz": "Yo'q, lug'at ko'rish mumkin emas. Va telefoningizni o'chirib qo'ying.",
        "en": "No, you can't use a dictionary. And please turn off your phone.",
        "audio": "5f35ee64b225.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "시험 시간에 화장실에 가도 돼요?",
        "uz": "Imtihon vaqtida hojatxonaga borsam bo'ladimi?",
        "en": "May I go to the toilet during the exam?",
        "audio": "adf27cd11bf7.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "지금 다녀오세요. 시험을 볼 때는 나가면 안 돼요.",
        "uz": "Hozir borib keling. Imtihon paytida chiqish mumkin emas.",
        "en": "Go now and come back. You can't leave during the exam.",
        "audio": "b4f681a11246.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "시험이 끝나면 먼저 나가도 돼요?",
        "uz": "Imtihonni tugatsam, avvalroq chiqsam bo'ladimi?",
        "en": "If I finish the exam, may I leave early?",
        "audio": "5691e83891ee.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "네, 답안지를 내고 나가도 돼요.",
        "uz": "Ha, javob varag'ini topshirib chiqsangiz bo'ladi.",
        "en": "Yes, you may leave after handing in your answer sheet.",
        "audio": "c6bc7527422a.mp3"
      },
      {
        "speaker": "aziz",
        "ko": "알겠습니다.",
        "uz": "Tushundim.",
        "en": "I understand.",
        "audio": "d590c6da03e6.mp3"
      },
      {
        "speaker": "teacher",
        "ko": "그럼 먼저 이름을 쓰세요. 시작하세요!",
        "uz": "Unda avval ismingizni yozing. Boshlang!",
        "en": "Then first write your name. Begin!",
        "audio": "a7d7dff768a7.mp3"
      }
    ]
