          "condition_uz": "받침 yo'q",
          "rule": "-ㄹ 때",
          "example": "가다 → 갈 때"
        },
        {
          "condition_uz": "받침 bor",
          "rule": "-을 때",
          "example": "먹다 → 먹을 때"
        },
        {
          "condition_uz": "ㄹ bilan tugasa",
          "rule": "때",
