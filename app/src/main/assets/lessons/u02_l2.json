  "grammar": [
    {
      "id": "u02_l2_g1",
      "pattern": "A-(으)ㄴ + N",
      "meaning_uz": "Sifatni otdan oldin ishlatish: 'uzun yubka', 'kichik sumka'",
      "explanation_md": "Koreys tilida sifat gap oxirida kelsa, oddiy tuslanadi: **치마가 길어요** — *Yubka uzun.*\n\nLekin sifat **otdan oldin** kelib, uni aniqlasa (*uzun yubka*), unga **-(으)ㄴ** qo'shiladi: **긴 치마**.\n\n### Qoidalar\n\n- **받침 yo'q** → **-ㄴ**: 크다 → **큰** 가방, 비싸다 → **비싼** 옷, 편하다 → **편한** 신발\n- **받침 bor** → **-은**: 작다 → **작은** 가방, 짧다 → **짧은** 머리\n- **ㄹ bilan tugasa** → ㄹ tushadi, **-ㄴ**: 길다 → **긴** 치마, 멀다 → **먼** 곳\n- **ㅂ bilan tugasa** → ㅂ o'rniga **-운**: 귀엽다 → **귀여운** 모자, 가볍다 → **가벼운** 코트, 어둡다 → **어두운** 색깔\n- **있다 / 없다** bilan tugasa → **-는**: 맛있다 → **맛있는** 음식, 재미없다 → **재미없는** 영화\n\n### Qiyoslash bilan birga\n\nBu darsning sarlavhasi ikkala grammatikani birlashtiradi: **더 긴 치마** — *uzunroq yubka*. Avval **더** (\"-roq\"), keyin **-(으)ㄴ** shaklidagi sifat, oxirida ot.\n\n### Esda tuting\n\nㅂ bilan tugaydigan sifatlar **-아/어요** shaklida ham o'zgaradi: 귀엽다 → 귀여**워요**, 무겁다 → 무거**워요**. Shuning uchun ularni juft qilib yodlang: **귀여워요 / 귀여운**.",
      "formation": [
        { "condition_uz": "받침 yo'q", "rule": "-ㄴ", "example": "크다 → 큰 가방, 비싸다 → 비싼 옷" },
        { "condition_uz": "받침 bor", "rule": "-은", "example": "작다 → 작은 가방, 짧다 → 짧은 머리" },
        { "condition_uz": "ㄹ bilan tugasa (ㄹ tushadi)", "rule": "-ㄴ", "example": "길다 → 긴 치마, 멀다 → 먼 곳" },
        { "condition_uz": "ㅂ bilan tugasa", "rule": "-운", "example": "귀엽다 → 귀여운 모자, 가볍다 → 가벼운 코트" },
        { "condition_uz": "있다 / 없다 bilan tugasa", "rule": "-는", "example": "맛있다 → 맛있는 음식" }
      ],
      "examples": [
        { "ko": "긴 치마를 찾아요.", "uz": "Uzun yubka qidiryapman." },
        { "ko": "작은 가방이 있어요?", "uz": "Kichik sumka bormi?" },
        { "ko": "편한 신발이 좋아요.", "uz": "Qulay poyabzal yaxshi." },
        { "ko": "귀여운 모자를 샀어요.", "uz": "Yoqimli shapka sotib oldim." },
        { "ko": "맛있는 음식을 먹었어요.", "uz": "Mazali taom yedim." },
        { "ko": "더 긴 치마는 없어요?", "uz": "Uzunroq yubka yo'qmi?" }
      ],
      "mistakes": [
        { "wrong": "길은 치마", "right": "긴 치마", "why_uz": "길다 ㄹ bilan tugaydi: ㄹ tushib qoladi va -ㄴ qo'shiladi." },
        { "wrong": "귀엽은 모자", "right": "귀여운 모자", "why_uz": "ㅂ bilan tugaydigan sifatlarda ㅂ → 우: 귀엽다 → 귀여운." },
        { "wrong": "맛있은 음식", "right": "맛있는 음식", "why_uz": "있다 / 없다 bilan tugaydigan so'zlarga -는 qo'shiladi." },
        { "wrong": "작는 가방", "right": "작은 가방", "why_uz": "Sifatda 받침 bo'lsa -은 qo'shiladi (-는 faqat 있다/없다 uchun)." }
      ],
      "uz_compare": "O'zbek tilida sifat otdan oldin hech o'zgarmaydi: 'uzun yubka', 'kichik sumka'. Koreys tilida esa sifat lug'at shaklida (길다) otdan oldin kela olmaydi — unga albatta -(으)ㄴ qo'shiladi: 긴 치마. Qoidani shunday eslang: gap oxirida — 치마가 길어요 (Yubka uzun), ot oldida — 긴 치마 (uzun yubka)."
    },
    {
      "id": "u02_l2_g2",
      "pattern": "N보다 (더) A",
      "meaning_uz": "Qiyoslash: '-dan ko'ra', '-ga qaraganda ...-roq'",
      "explanation_md": "**보다** otga qo'shilib, o'zbekchadagi **\"-dan (ko'ra)\"** ma'nosini beradi. Sifatdan oldin keladigan **더** esa **\"-roq\"** qo'shimchasiga to'g'ri keladi.\n\n**이 치마가 저 치마보다 더 길어요.**\n*Bu yubka ana u yubkadan uzunroq.*\n\n### Qoidalar\n\n- **보다** otga to'g'ridan-to'g'ri qo'shiladi, 받침ga qarab o'zgarmaydi: 치마**보다**, 바지**보다**, 어제**보다**.\n- **보다** bilan birga **이/가**, **을/를** ishlatilmaydi: ~~치마가보다~~ → **치마보다**.\n- **더** ni tushirib qoldirish mumkin, chunki **보다** o'zi qiyoslashni bildiradi: 오늘은 어제보다 추워요.\n- So'z tartibi erkin: **저 치마보다 이 치마가 더 길어요** ham to'g'ri.\n\n### Qo'shimcha so'zlar\n\n- **덜** — *kamroq*: 이 옷이 **덜** 비싸요.\n- **제일** — *eng*: 이게 **제일** 예뻐요.\n\n### Savol berish\n\n**뭐가 더 좋아요?** — *Qaysi biri yaxshiroq?*\n**커피하고 차 중에서 뭐가 더 좋아요?** — *Qahva va choydan qaysi birini ko'proq yoqtirasiz?*",
      "formation": [
        { "condition_uz": "Qiyoslanadigan ot", "rule": "N보다", "example": "치마보다, 어제보다" },
        { "condition_uz": "Ko'proq, -roq", "rule": "더 + A", "example": "더 길어요, 더 싸요" },
        { "condition_uz": "Kamroq", "rule": "덜 + A", "example": "덜 비싸요" },
        { "condition_uz": "Eng", "rule": "제일 + A", "example": "제일 예뻐요" }
      ],
      "examples": [
        { "ko": "이 치마가 저 치마보다 더 길어요.", "uz": "Bu yubka ana u yubkadan uzunroq." },
        { "ko": "바지보다 치마가 더 편해요.", "uz": "Shimdan ko'ra yubka qulayroq." },
        { "ko": "오늘은 어제보다 추워요.", "uz": "Bugun kechagidan sovuq." },
        { "ko": "커피보다 차를 더 좋아해요.", "uz": "Qahvadan ko'ra choyni ko'proq yoqtiraman." },
        { "ko": "이게 제일 싸요.", "uz": "Bu eng arzoni." },
        { "ko": "더 싼 가방은 없어요?", "uz": "Arzonroq sumka yo'qmi?" }
      ],
      "mistakes": [
        { "wrong": "저 치마가보다 길어요", "right": "저 치마보다 길어요", "why_uz": "보다 otga to'g'ridan-to'g'ri qo'shiladi, 이/가 bilan birga ishlatilmaydi." },
        { "wrong": "이 가방이 더 무겁어요", "right": "이 가방이 더 무거워요", "why_uz": "무겁다 ㅂ bilan tugaydi: 무겁 + 어요 → 무거워요." },
        { "wrong": "더 크은 사이즈", "right": "더 큰 사이즈", "why_uz": "크다 da 받침 yo'q, shuning uchun -ㄴ: 큰." }
      ],
      "uz_compare": "O'zbekchadagi '-dan' (yoki '-ga qaraganda') koreyscha 보다 ga to'g'ri keladi, '-roq' qo'shimchasi o'rniga esa sifatdan oldin 더 qo'yiladi. 'Bu yubka u yubkaDAN uzunROQ' = 이 치마가 저 치마보다 더 길어요. So'z tartibi ham deyarli bir xil: nima — nimadan — qanday."
    }
  ],
